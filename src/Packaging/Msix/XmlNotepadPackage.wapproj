<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(ProjectDir)..\..\Version\Version.props" />
  <PropertyGroup Condition="'$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '15.0'">
    <VisualStudioVersion>15.0</VisualStudioVersion>
  </PropertyGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x86">
      <Configuration>Debug</Configuration>
      <Platform>x86</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x86">
      <Configuration>Release</Configuration>
      <Platform>x86</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|AnyCPU">
      <Configuration>Debug</Configuration>
      <Platform>AnyCPU</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|AnyCPU">
      <Configuration>Release</Configuration>
      <Platform>AnyCPU</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup>
    <WapProjPath Condition="'$(WapProjPath)'==''">$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\</WapProjPath>
    <PathToXAMLWinRTImplementations>XmlNotepad\</PathToXAMLWinRTImplementations>
    <WinUISDKReferences>false</WinUISDKReferences>
  </PropertyGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.props" />
  <PropertyGroup>
    <ProjectGuid>026f426d-0a2b-4782-98fd-717d91fae019</ProjectGuid>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <AssetTargetFallback>net11.0-windows$(TargetPlatformVersion);$(AssetTargetFallback)</AssetTargetFallback>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <PackageCertificateThumbprint Condition="'$(PackageCertificateThumbprint)' == ''">F0DEC4CF1C07CB9E44E29D98389072C8579D5E79</PackageCertificateThumbprint>
    <EntryPointProjectUniqueName>..\..\Application\XmlNotepad.csproj</EntryPointProjectUniqueName>
    <GenerateAppInstallerFile>True</GenerateAppInstallerFile>
    <AppxPackageSigningTimestampServerUrl>http://timestamp.sectigo.com</AppxPackageSigningTimestampServerUrl>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <AppxBundle>Always</AppxBundle>
    <AppxBundlePlatforms>$(Platform)</AppxBundlePlatforms>
    <AppInstallerUri>https://lovettsoftwarestorage.blob.core.windows.net/downloads/XmlNotepad.Net/</AppInstallerUri>
    <HoursBetweenUpdateChecks>24</HoursBetweenUpdateChecks>
    <AppxPackageDir>$(ProjectDir)AppPackages\$(ApplicationVersion)\</AppxPackageDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <AppxBundlePlatforms>x86|x64|ARM64</AppxBundlePlatforms>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Images\*.scale-*.png;Images\*targetsize-*.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Application\XmlNotepad.csproj">
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <PublishProfile>Properties\PublishProfiles\win-$(Platform.ToLowerInvariant()).pubxml</PublishProfile>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.targets" />
  <Target Name="FindVCLibs" AfterTargets="_GetRecursiveResolvedSDKReferences">
    <ItemGroup>
      <_VCLibs Include="@(FrameworkSdkPackage)" Condition="'%(FrameworkSdkPackage.Name)' == 'Microsoft.VCLibs.140.00.UWPDesktop'" />
      <_Arm64VCLibs Include="@(_VCLibs)" Condition="'%(_VCLibs.Architecture)' == 'arm64'" />
    </ItemGroup>
  </Target>
  <Target Name="ResolveArm64VCLibs" BeforeTargets="GenerateAppInstallerFileForPackage"
          Condition="'@(_Arm64VCLibs)' == '' and $([System.String]::Copy('$(AppxBundlePlatforms)').ToLowerInvariant().Contains('arm64'))">
    <PropertyGroup>
      <_VCLibsVersion>14.0.33728.0</_VCLibsVersion>
      <_VCLibsCache>$(MSBuildProjectDirectory)\obj\AppInstallerDependencies</_VCLibsCache>
      <_VCLibsArchive>DesktopAppInstaller_Dependencies-v1.29.380.zip</_VCLibsArchive>
      <_VCLibsFile>Microsoft.VCLibs.140.00.UWPDesktop_$(_VCLibsVersion)_arm64.appx</_VCLibsFile>
    </PropertyGroup>
    <Error Condition="'%(_VCLibs.Version)' != '' and $([MSBuild]::VersionGreaterThan('%(_VCLibs.Version)', '$(_VCLibsVersion)'))"
           Text="Update the ARM64 Visual C++ framework to match the newer SDK dependency." />
    <DownloadFile SourceUrl="https://github.com/microsoft/winget-cli/releases/download/v1.29.380/DesktopAppInstaller_Dependencies.zip"
                  DestinationFolder="$(_VCLibsCache)" DestinationFileName="$(_VCLibsArchive)"
                  Condition="!Exists('$(_VCLibsCache)/$(_VCLibsArchive)')" />
    <VerifyFileHash File="$(_VCLibsCache)/$(_VCLibsArchive)" Hash="BA875AFE9D190F61218985AC0292A99D1DB710BF93E13C68944CA9D89F0D82D1" />
    <Unzip SourceFiles="$(_VCLibsCache)/$(_VCLibsArchive)" DestinationFolder="$(_VCLibsCache)" />
    <Copy SourceFiles="$(_VCLibsCache)/arm64/$(_VCLibsFile)" DestinationFolder="$(AppxPackageTestDir)Dependencies/arm64" />
    <ItemGroup>
      <FrameworkSdkPackage Include="$(_VCLibsCache)/arm64/$(_VCLibsFile)">
        <Name>Microsoft.VCLibs.140.00.UWPDesktop</Name>
        <Architecture>arm64</Architecture>
        <Version>$(_VCLibsVersion)</Version>
        <Publisher>CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US</Publisher>
      </FrameworkSdkPackage>
    </ItemGroup>
  </Target>
</Project>
