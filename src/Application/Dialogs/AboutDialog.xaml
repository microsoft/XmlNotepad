<ContentDialog
    x:Class="XmlNotepad.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="AboutDialog"
    Title="About XML Notepad"
    CornerRadius="{ThemeResource OverlayCornerRadius}"
    CloseButtonText="Close"
    DefaultButton="Close">
    <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Image Source="ms-appx:///Assets/XmlNotepad.png" Width="40" Height="40" />
            <TextBlock Text="{x:Bind VersionLabel, Mode=OneTime}" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="AboutVersion" />
        </StackPanel>
        <TextBlock Text="{x:Bind CopyrightLabel, Mode=OneTime}" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <HyperlinkButton Content="XML Notepad documentation" NavigateUri="{x:Bind DocumentationUri, Mode=OneTime}" Padding="0" />
    </StackPanel>
</ContentDialog>
