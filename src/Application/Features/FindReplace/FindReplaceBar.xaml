<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="XmlNotepad.FindReplaceBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="Find and replace"
    PreviewKeyDown="SearchBar_KeyDown"
    Unloaded="SearchBar_Unloaded">
    <UserControl.Resources>
        <Style x:Key="FindInputStyle" TargetType="TextBox" BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}">
            <Setter Property="AutomationProperties.AutomationId" Value="FindText" />
            <Setter Property="AutomationProperties.Name" Value="Find" />
        </Style>
        <Style x:Key="SearchIconButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <Border
        Padding="8"
        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource OverlayCornerRadius}">
        <Border.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="-6" />
            </TransitionCollection>
        </Border.Transitions>
        <StackPanel Spacing="6">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="4">
                <Button
                    x:Name="ExpandButton"
                    Style="{StaticResource SearchIconButton}"
                    Click="ExpandButton_Click"
                    ToolTipService.ToolTip="Show replace"
                    AutomationProperties.Name="Show replace"
                    AutomationProperties.AutomationId="ToggleReplace">
                    <FontIcon x:Name="ExpandIcon" Glyph="&#xE70D;" FontSize="12" />
                </Button>
                <AutoSuggestBox
                    x:Name="FindTextBox"
                    Grid.Column="1"
                    MinWidth="0"
                    Height="32"
                    PlaceholderText="Find"
                    TextBoxStyle="{StaticResource FindInputStyle}"
                    QueryIcon="Find"
                    TextChanged="FindTextBox_TextChanged"
                    QuerySubmitted="FindTextBox_QuerySubmitted"
                    AutomationProperties.Name="Find" />
                <Button
                    x:Name="PreviousButton"
                    Grid.Column="2"
                    Style="{StaticResource SearchIconButton}"
                    Click="PreviousButton_Click"
                    ToolTipService.ToolTip="Previous match (Shift+F3)"
                    AutomationProperties.Name="Previous match"
                    AutomationProperties.AutomationId="FindPrevious">
                    <FontIcon Glyph="&#xE74A;" FontSize="16" />
                </Button>
                <Button
                    x:Name="NextButton"
                    Grid.Column="3"
                    Style="{StaticResource SearchIconButton}"
                    Click="NextButton_Click"
                    ToolTipService.ToolTip="Next match (F3)"
                    AutomationProperties.Name="Next match"
                    AutomationProperties.AutomationId="FindNext">
                    <FontIcon Glyph="&#xE74B;" FontSize="16" />
                </Button>
                <Button
                    x:Name="OptionsButton"
                    Grid.Column="4"
                    Style="{StaticResource SearchIconButton}"
                    Click="OptionsButton_Click"
                    ToolTipService.ToolTip="Search options"
                    AutomationProperties.Name="Search options"
                    AutomationProperties.AutomationId="SearchOptions">
                    <FontIcon Glyph="&#xE71C;" FontSize="16" />
                </Button>
                <Button
                    Grid.Column="5"
                    Style="{StaticResource SearchIconButton}"
                    Click="CloseButton_Click"
                    ToolTipService.ToolTip="Close search (Esc)"
                    AutomationProperties.Name="Close search"
                    AutomationProperties.AutomationId="CloseSearch">
                    <FontIcon Glyph="&#xE711;" FontSize="16" />
                </Button>
            </Grid>
            <Grid x:Name="ReplaceRow" Margin="36,0,0,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Visibility="Collapsed">
                <Grid.Transitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="-4" />
                    </TransitionCollection>
                </Grid.Transitions>
                <TextBox
                    x:Name="ReplaceTextBox"
                    MinWidth="0"
                    Height="32"
                    PlaceholderText="Replace"
                    AutomationProperties.Name="Replace with"
                    AutomationProperties.AutomationId="ReplaceText" />
                <Button
                    x:Name="ReplaceButton"
                    Grid.Column="1"
                    Content="Replace"
                    Click="ReplaceButton_Click"
                    AutomationProperties.AutomationId="Replace" />
                <Button
                    x:Name="ReplaceAllButton"
                    Grid.Column="2"
                    Content="Replace all"
                    Click="ReplaceAllButton_Click"
                    AutomationProperties.AutomationId="ReplaceAll" />
            </Grid>
            <Grid x:Name="SearchDetails" Margin="36,0,4,0" ColumnDefinitions="*,Auto" ColumnSpacing="12"
                  Visibility="Collapsed">
                <TextBlock
                    x:Name="StatusText"
                    Visibility="Collapsed"
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.AutomationId="SearchStatus" />
                <TextBlock
                    x:Name="SearchModeText"
                    Grid.Column="1"
                    MaxWidth="220"
                    TextTrimming="CharacterEllipsis"
                    Visibility="Collapsed"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    AutomationProperties.AutomationId="SearchMode" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
