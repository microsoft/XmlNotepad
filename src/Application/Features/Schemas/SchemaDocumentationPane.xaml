<UserControl
    x:Class="XmlNotepad.SchemaDocumentationPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="SchemaDocumentationPane">
    <ScrollViewer x:Name="DocumentationScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="DocumentationContent" Padding="12,7" Spacing="4">
            <TextBlock x:Name="NodeName" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Name="DocumentationText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                       AutomationProperties.AutomationId="SchemaDocumentationText" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
