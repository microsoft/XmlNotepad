<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="XmlNotepad.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:XmlNotepad"
    xmlns:models="using:XmlNotepad.ViewModels"
    xmlns:services="using:XmlNotepad.Services"
    KeyboardAcceleratorPlacementMode="Hidden"
    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
    <Page.Resources>
        <ColumnDefinition x:Key="XmlValueColumnWidth" Width="0" />
        <Style x:Key="NodeValuePreviewStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="NodeValueCellStyle" TargetType="Grid">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <DataTemplate x:Key="XmlSuggestionTemplate">
            <Border Padding="8,4" ToolTipService.ToolTip="{Binding Tooltip}">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Namespace}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="XmlValueSuggestionTemplate" x:DataType="services:XmlSuggestion">
            <TextBlock Text="{x:Bind Name, Mode=OneTime}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneTime}" />
        </DataTemplate>
        <Style x:Key="XmlValueSuggestionItemStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="ToolbarButtonStyle" TargetType="AppBarButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="LabelPosition" Value="Collapsed" />
        </Style>
        <MenuFlyout x:Key="XmlNodeContextMenu">
            <MenuFlyoutItem Text="Expand Branch" Click="ExpandBranch_Click" AutomationProperties.AutomationId="ExpandBranchContext" />
            <MenuFlyoutItem Text="Collapse Branch" Click="CollapseBranch_Click" AutomationProperties.AutomationId="CollapseBranchContext" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Insert Element..." Click="InsertElement_Click" />
            <MenuFlyoutItem Text="Insert Attribute..." Click="InsertAttribute_Click" />
            <MenuFlyoutItem Text="Insert Text..." Click="InsertText_Click" />
            <MenuFlyoutItem Text="Insert Comment..." Click="InsertComment_Click" />
            <MenuFlyoutItem Text="Rename..." Click="RenameNode_Click" />
            <MenuFlyoutItem Text="Duplicate" Tag="Duplicate" Click="DuplicateNode_Click" />
            <MenuFlyoutSubItem Text="Change To" AutomationProperties.AutomationId="ChangeNodeTypeContext">
                <MenuFlyoutItem Text="Element" Tag="Element" Click="ChangeNodeType_Click" />
                <MenuFlyoutItem Text="Attribute" Tag="Attribute" Click="ChangeNodeType_Click" />
                <MenuFlyoutItem Text="Text" Tag="Text" Click="ChangeNodeType_Click" />
                <MenuFlyoutItem Text="CDATA" Tag="CDATA" Click="ChangeNodeType_Click" />
                <MenuFlyoutItem Text="Comment" Tag="Comment" Click="ChangeNodeType_Click" />
                <MenuFlyoutItem Text="Processing Instruction" Tag="ProcessingInstruction" Click="ChangeNodeType_Click" />
            </MenuFlyoutSubItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Cut" Click="Cut_Click" />
            <MenuFlyoutItem Text="Copy" Click="Copy_Click" />
            <MenuFlyoutItem Text="Copy XPath" Click="CopyXPath_Click" AutomationProperties.AutomationId="CopyXPathContext" />
            <MenuFlyoutItem Text="Go to Definition" Click="GoToDefinition_Click" AutomationProperties.AutomationId="GoToDefinitionContext" />
            <MenuFlyoutItem Text="Paste" Click="Paste_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Delete" Click="DeleteNode_Click" />
        </MenuFlyout>
    </Page.Resources>
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="New_AcceleratorInvoked" />
        <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="Open_AcceleratorInvoked" />
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="Save_AcceleratorInvoked" />
        <KeyboardAccelerator Key="X" Modifiers="Control" Invoked="Cut_AcceleratorInvoked" />
        <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="Copy_AcceleratorInvoked" />
        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="Paste_AcceleratorInvoked" />
        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="Undo_AcceleratorInvoked" />
        <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="Redo_AcceleratorInvoked" />
        <KeyboardAccelerator Key="F6" Invoked="FocusNextPane_AcceleratorInvoked" />
        <KeyboardAccelerator Key="F6" Modifiers="Shift" Invoked="FocusPreviousPane_AcceleratorInvoked" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="Find_AcceleratorInvoked" />
        <KeyboardAccelerator Key="H" Modifiers="Control" Invoked="Replace_AcceleratorInvoked" />
        <KeyboardAccelerator Key="I" Modifiers="Control" Invoked="IncrementalSearch_AcceleratorInvoked" />
        <KeyboardAccelerator Key="F3" Invoked="FindNext_AcceleratorInvoked" />
        <KeyboardAccelerator Key="F3" Modifiers="Shift" Invoked="FindPrevious_AcceleratorInvoked" />
        <KeyboardAccelerator Key="F2" Invoked="Rename_AcceleratorInvoked" />
        <KeyboardAccelerator Key="F1" Invoked="Help_AcceleratorInvoked" />
    </Page.KeyboardAccelerators>
    <Grid x:Name="LayoutRoot" RowDefinitions="Auto,Auto,*,Auto,Auto" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          SizeChanged="LayoutRoot_SizeChanged" AllowDrop="True" DragEnter="File_DragOver" DragOver="File_DragOver" Drop="File_Drop">
        <MenuBar>
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="New" Click="New_Click" />
                <MenuFlyoutItem Text="New Window" Click="NewWindow_Click" AutomationProperties.AutomationId="NewWindow" />
                <MenuFlyoutItem Text="Open..." Click="Open_Click" />
                <MenuFlyoutItem Text="Open from URL…" Click="OpenUrl_Click" AutomationProperties.AutomationId="OpenUrl" />
                <MenuFlyoutItem Text="Save" Click="Save_Click" />
                <MenuFlyoutItem Text="Save As..." Click="SaveAs_Click" />
                <MenuFlyoutItem Text="Reload from disk" Click="ReloadFromDisk_Click"
                                IsEnabled="{x:Bind ViewModel.HasFilePath, Mode=OneWay}"
                                AutomationProperties.AutomationId="ReloadFromDisk" />
                <MenuFlyoutItem Text="Compare XML files…" Click="CompareXml_Click"
                                IsEnabled="{x:Bind ViewModel.HasFilePath, Mode=OneWay}"
                                AutomationProperties.AutomationId="CompareXml" />
                <MenuFlyoutItem Text="Open Comparison Styles…" Click="OpenComparisonStyles_Click"
                                AutomationProperties.AutomationId="OpenComparisonStyles" />
                <MenuFlyoutSubItem Text="Recent Files" x:Name="RecentFilesMenu" />
                <MenuFlyoutItem Text="Open XML Settings…" Click="OpenSettings_Click" AutomationProperties.AutomationId="OpenXmlSettings" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="Exit_Click" AutomationProperties.AutomationId="ExitApplication" />
            </MenuBarItem>
            <MenuBarItem Title="Edit">
                <MenuFlyoutItem Text="Undo" Click="Undo_Click" IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}" />
                <MenuFlyoutItem Text="Redo" Click="Redo_Click" IsEnabled="{x:Bind ViewModel.CanRedo, Mode=OneWay}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Cut" Click="Cut_Click" />
                <MenuFlyoutItem Text="Copy" Click="Copy_Click" />
                <MenuFlyoutItem Text="Copy XPath" Click="CopyXPath_Click" IsEnabled="{x:Bind ViewModel.CanCopySelectedNode, Mode=OneWay}" AutomationProperties.AutomationId="CopyXPath" />
                <MenuFlyoutItem Text="Paste" Click="Paste_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Insert Same Type…" Click="InsertSibling_Click"
                                IsEnabled="{x:Bind ViewModel.CanInsertSiblingOfSameType, Mode=OneWay}"
                                AutomationProperties.AutomationId="InsertSameType" />
                <MenuFlyoutItem Text="Rename Selected Node..." Click="RenameNode_Click" />
                <MenuFlyoutItem Text="Edit Multiline Value" Click="EditMultilineValue_Click"
                                IsEnabled="{x:Bind ViewModel.CanEditValue, Mode=OneWay}"
                                AutomationProperties.AutomationId="EditMultilineValue" />
                <MenuFlyoutItem Text="Duplicate Selected Node" Click="DuplicateNode_Click" IsEnabled="{x:Bind ViewModel.CanDuplicateSelectedNode, Mode=OneWay}" />
                <MenuFlyoutSubItem Text="Change To" AutomationProperties.AutomationId="ChangeNodeType">
                    <MenuFlyoutItem Text="Element" Tag="Element" Click="ChangeNodeType_Click" IsEnabled="{x:Bind ViewModel.CanConvertNode(ViewModel.SelectedNode, 'Element'), Mode=OneWay}" />
                    <MenuFlyoutItem Text="Attribute" Tag="Attribute" Click="ChangeNodeType_Click" IsEnabled="{x:Bind ViewModel.CanConvertNode(ViewModel.SelectedNode, 'Attribute'), Mode=OneWay}" />
                    <MenuFlyoutItem Text="Text" Tag="Text" Click="ChangeNodeType_Click" IsEnabled="{x:Bind ViewModel.CanConvertNode(ViewModel.SelectedNode, 'Text'), Mode=OneWay}" />
                    <MenuFlyoutItem Text="CDATA" Tag="CDATA" Click="ChangeNodeType_Click" IsEnabled="{x:Bind ViewModel.CanConvertNode(ViewModel.SelectedNode, 'CDATA'), Mode=OneWay}" />
                    <MenuFlyoutItem Text="Comment" Tag="Comment" Click="ChangeNodeType_Click" IsEnabled="{x:Bind ViewModel.CanConvertNode(ViewModel.SelectedNode, 'Comment'), Mode=OneWay}" />
                    <MenuFlyoutItem Text="Processing Instruction" Tag="ProcessingInstruction" Click="ChangeNodeType_Click" IsEnabled="{x:Bind ViewModel.CanConvertNode(ViewModel.SelectedNode, 'ProcessingInstruction'), Mode=OneWay}" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem Text="Delete Selected Node" Click="DeleteNode_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Find and Replace..." Click="FindReplace_Click" />
                <MenuFlyoutItem Text="Incremental Search" Click="IncrementalSearch_Click" AutomationProperties.AutomationId="IncrementalSearch" />
                <MenuFlyoutItem Text="Find Next" Click="FindNext_Click" />
                <MenuFlyoutItem Text="Go To Line&#x2026;" Click="GoToLine_Click"
                                IsEnabled="{x:Bind ViewModel.CanGoToLine, Mode=OneWay}"
                                AutomationProperties.AutomationId="GoToLine">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="G" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />              
                <MenuFlyoutItem Text="GC.Collect" Click="CollectGarbage_Click" />
            </MenuBarItem>
            <MenuBarItem Title="View">
                <MenuFlyoutItem Text="Expand Branch" Click="ExpandBranch_Click" AutomationProperties.AutomationId="ExpandBranch" />
                <MenuFlyoutItem Text="Collapse Branch" Click="CollapseBranch_Click" AutomationProperties.AutomationId="CollapseBranch" />
                <MenuFlyoutItem Text="Expand All" Click="ExpandAll_Click" />
                <MenuFlyoutItem Text="Collapse All" Click="CollapseAll_Click" />
                <ToggleMenuFlyoutItem x:Name="StatusBarToggle" Text="Status Bar" Click="StatusBarToggle_Click"
                                    AutomationProperties.AutomationId="ToggleStatusBar" />
                <MenuFlyoutItem Text="Open in text editor" Click="OpenInTextEditor_Click"
                                IsEnabled="{x:Bind ViewModel.HasFilePath, Mode=OneWay}"
                                AutomationProperties.AutomationId="OpenInTextEditor" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Go to Definition" Click="GoToDefinition_Click" AutomationProperties.AutomationId="GoToDefinition">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F12" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Validate XML" Click="ValidateXml_Click" AutomationProperties.AutomationId="ValidateXml" />
                <MenuFlyoutItem Text="XML Statistics…" Click="XmlStatistics_Click" AutomationProperties.AutomationId="ShowXmlStatistics" />
                <MenuFlyoutItem Text="Next Error" Click="NextError_Click" AutomationProperties.AutomationId="NextError">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F4" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Export Errors…" Click="ExportErrors_Click" AutomationProperties.AutomationId="ExportErrors" />
                <MenuFlyoutItem Text="Expand XIncludes" Click="ExpandXIncludes_Click" AutomationProperties.AutomationId="ExpandXIncludes" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="View XSLT result" Click="ViewXsltResult_Click" AutomationProperties.AutomationId="ViewXsltResult" />
                <MenuFlyoutItem Text="Transform with XSLT…" Click="TransformWithXslt_Click" AutomationProperties.AutomationId="TransformWithXslt" />
                <MenuFlyoutItem Text="Manage schemas…" Click="ManageSchemas_Click" AutomationProperties.AutomationId="ManageSchemas" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Options…" Click="Options_Click" AutomationProperties.AutomationId="EditorOptions" />
            </MenuBarItem>
            <MenuBarItem Title="Insert">
                <MenuFlyoutSubItem Text="Element">
                    <MenuFlyoutItem Text="Before" Tag="Element|Before" Click="InsertNodeAtPosition_Click" />
                    <MenuFlyoutItem Text="After" Tag="Element|After" Click="InsertNodeAtPosition_Click" />
                    <MenuFlyoutItem Text="Child" Tag="Element|Child" Click="InsertNodeAtPosition_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="Attribute">
                    <MenuFlyoutItem Text="Before" Tag="Attribute|Before" Click="InsertNodeAtPosition_Click" />
                    <MenuFlyoutItem Text="After" Tag="Attribute|After" Click="InsertNodeAtPosition_Click" />
                    <MenuFlyoutItem Text="Child" Tag="Attribute|Child" Click="InsertNodeAtPosition_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="Text">
                    <MenuFlyoutItem Text="Before" Tag="Text|Before" Click="InsertNodeAtPosition_Click" />
                    <MenuFlyoutItem Text="After" Tag="Text|After" Click="InsertNodeAtPosition_Click" />
                    <MenuFlyoutItem Text="Child" Tag="Text|Child" Click="InsertNodeAtPosition_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="Comment">
                    <MenuFlyoutItem Text="Before" Tag="Comment|Before" Click="InsertNodeAtPosition_Click" />
                    <MenuFlyoutItem Text="After" Tag="Comment|After" Click="InsertNodeAtPosition_Click" />
                    <MenuFlyoutItem Text="Child" Tag="Comment|Child" Click="InsertNodeAtPosition_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="CDATA">
                    <MenuFlyoutItem Text="Before" Tag="CDATA|Before" Click="InsertNodeAtPosition_Click" />
                    <MenuFlyoutItem Text="After" Tag="CDATA|After" Click="InsertNodeAtPosition_Click" />
                    <MenuFlyoutItem Text="Child" Tag="CDATA|Child" Click="InsertNodeAtPosition_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="Processing Instruction">
                    <MenuFlyoutItem Text="Before" Tag="ProcessingInstruction|Before" Click="InsertNodeAtPosition_Click" />
                    <MenuFlyoutItem Text="After" Tag="ProcessingInstruction|After" Click="InsertNodeAtPosition_Click" />
                    <MenuFlyoutItem Text="Child" Tag="ProcessingInstruction|Child" Click="InsertNodeAtPosition_Click" />
                </MenuFlyoutSubItem>
            </MenuBarItem>
            <MenuBarItem Title="Help" AutomationProperties.AutomationId="HelpMenu">
                <MenuFlyoutItem Text="Documentation" Click="Help_Click" AutomationProperties.AutomationId="OpenDocumentation" />
                <MenuFlyoutItem Text="Open sample…" Click="OpenSample_Click" AutomationProperties.AutomationId="OpenSample" />
                <MenuFlyoutItem Text="File Associations…" Click="FileAssociations_Click" AutomationProperties.AutomationId="FileAssociations" />
                <MenuFlyoutItem x:Name="CheckForUpdatesItem" Text="Check for updates" Click="CheckForUpdates_Click"
                                AutomationProperties.AutomationId="CheckForUpdates" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="About XML Notepad" Click="About_Click" AutomationProperties.AutomationId="AboutXmlNotepad" />
            </MenuBarItem>
        </MenuBar>

        <CommandBar
            Grid.Row="1"
            HorizontalAlignment="Left"
            DefaultLabelPosition="Collapsed"
            IsDynamicOverflowEnabled="True"
            AutomationProperties.Name="XML document toolbar">
            <CommandBar.PrimaryCommands>
                <AppBarButton Style="{StaticResource ToolbarButtonStyle}" Label="New" ToolTipService.ToolTip="New document (Ctrl+N)" Click="New_Click" AutomationProperties.Name="New document" AutomationProperties.AutomationId="NewDocumentButton">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8A5;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Style="{StaticResource ToolbarButtonStyle}" Label="Open" ToolTipService.ToolTip="Open document (Ctrl+O)" Click="Open_Click" AutomationProperties.Name="Open document" AutomationProperties.AutomationId="OpenDocumentButton">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8E5;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Style="{StaticResource ToolbarButtonStyle}" Label="Save" ToolTipService.ToolTip="Save document (Ctrl+S)" Click="Save_Click" AutomationProperties.Name="Save document" AutomationProperties.AutomationId="SaveDocumentButton">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Style="{StaticResource ToolbarButtonStyle}" Label="Undo" ToolTipService.ToolTip="Undo" Click="Undo_Click" IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}" AutomationProperties.Name="Undo" AutomationProperties.AutomationId="UndoButton">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE7A7;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Style="{StaticResource ToolbarButtonStyle}" Label="Redo" ToolTipService.ToolTip="Redo" Click="Redo_Click" IsEnabled="{x:Bind ViewModel.CanRedo, Mode=OneWay}" AutomationProperties.Name="Redo" AutomationProperties.AutomationId="RedoButton">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE7A6;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Style="{StaticResource ToolbarButtonStyle}" Label="Cut" ToolTipService.ToolTip="Cut node" Click="Cut_Click" IsEnabled="{x:Bind ViewModel.CanCutSelectedNode, Mode=OneWay}" AutomationProperties.Name="Cut node" AutomationProperties.AutomationId="CutNodeButton">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8C6;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Style="{StaticResource ToolbarButtonStyle}" Label="Copy" ToolTipService.ToolTip="Copy node" Click="Copy_Click" IsEnabled="{x:Bind ViewModel.CanCopySelectedNode, Mode=OneWay}" AutomationProperties.Name="Copy node" AutomationProperties.AutomationId="CopyNodeButton">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8C8;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Style="{StaticResource ToolbarButtonStyle}" Label="Paste" ToolTipService.ToolTip="Paste node" Click="Paste_Click" AutomationProperties.Name="Paste node" AutomationProperties.AutomationId="PasteNodeButton">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE77F;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Style="{StaticResource ToolbarButtonStyle}" Label="Delete" ToolTipService.ToolTip="Delete node" Click="DeleteNode_Click" IsEnabled="{x:Bind ViewModel.CanDeleteSelectedNode, Mode=OneWay}" AutomationProperties.Name="Delete node" AutomationProperties.AutomationId="DeleteNodeButton">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Style="{StaticResource ToolbarButtonStyle}" Label="Move up" ToolTipService.ToolTip="Move node up" Click="NudgeUp_Click" IsEnabled="{x:Bind ViewModel.CanNudgeUp, Mode=OneWay}" AutomationProperties.Name="Move node up" AutomationProperties.AutomationId="MoveNodeUpButton">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74A;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Style="{StaticResource ToolbarButtonStyle}" Label="Move down" ToolTipService.ToolTip="Move node down" Click="NudgeDown_Click" IsEnabled="{x:Bind ViewModel.CanNudgeDown, Mode=OneWay}" AutomationProperties.Name="Move node down" AutomationProperties.AutomationId="MoveNodeDownButton">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74B;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Style="{StaticResource ToolbarButtonStyle}" Label="Move left" ToolTipService.ToolTip="Move node left" Click="NudgeLeft_Click" IsEnabled="{x:Bind ViewModel.CanNudgeLeft, Mode=OneWay}" AutomationProperties.Name="Move node left" AutomationProperties.AutomationId="MoveNodeLeftButton">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE76B;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Style="{StaticResource ToolbarButtonStyle}" Label="Move right" ToolTipService.ToolTip="Move node right" Click="NudgeRight_Click" IsEnabled="{x:Bind ViewModel.CanNudgeRight, Mode=OneWay}" AutomationProperties.Name="Move node right" AutomationProperties.AutomationId="MoveNodeRightButton">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE76C;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.PrimaryCommands>
        </CommandBar>

        <Grid x:Name="Workspace" Grid.Row="2" RowDefinitions="*,Auto" SizeChanged="Workspace_SizeChanged">
            <Grid x:Name="EditorPanes" RowDefinitions="32,*,Auto" SizeChanged="EditorPanes_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TreeColumn" Width="2*" />
                    <ColumnDefinition x:Name="SplitterColumn" Width="12" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3" Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <TextBlock Text="Node" Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="Value" Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                <controls:XmlTreeList
                    x:Name="XmlTree"
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    controls:EditorColorOverride.Background="{x:Bind ViewModel.Palette.Brushes.DocumentBackground, Mode=OneWay, FallbackValue={x:Null}}"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectionMode="Single"
                    SingleSelectionFollowsFocus="True"
                    CanDragItems="True"
                    CanReorderItems="False"
                    DragItemsStarting="Node_DragStarting"
                    DragItemsCompleted="Node_DropCompleted"
                    SelectionChanged="XmlTree_SelectionChanged"
                    PreviewKeyDown="XmlTree_PreviewKeyDown"
                    ContextRequested="XmlTreeItem_ContextRequested"
                    AutomationProperties.HelpText="Press Enter to edit the selected node value."
                    AutomationProperties.AutomationId="XmlTree">
                    <controls:XmlTreeList.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" />
                        </ItemsPanelTemplate>
                    </controls:XmlTreeList.ItemsPanel>
                    <controls:XmlTreeList.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </controls:XmlTreeList.ItemContainerStyle>
                    <controls:XmlTreeList.ItemTemplate>
                        <DataTemplate x:DataType="models:XmlNodeItem">
                            <Grid AllowDrop="True" DragEnter="Node_DragOver" DragOver="Node_DragOver" Drop="Node_Drop">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{Binding Width, Source={StaticResource XmlValueColumnWidth}}" />
                                </Grid.ColumnDefinitions>
                                <Grid ColumnDefinitions="28,16,*" ColumnSpacing="8"
                                      Padding="{x:Bind GetIndentation(Typography.TreeIndent), Mode=OneWay}" Margin="0,0,12,0">
                                    <Button Width="28" MinWidth="0" MinHeight="0" Padding="0" HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                            IsTabStop="False" Click="TreeRowExpansion_Click"
                                            Visibility="{x:Bind CanExpand, Mode=OneWay}"
                                            AutomationProperties.AccessibilityView="Raw"
                                            AutomationProperties.Name="{x:Bind ExpansionLabel, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind ExpansionGlyph, Mode=OneWay}" FontSize="10"
                                                   FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                    </Button>
                                    <TextBlock Grid.Column="1" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14"
                                               Text="{x:Bind IconGlyph, Mode=OneTime}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Grid.Column="2"
                                               FontFamily="{x:Bind Typography.Family, Mode=OneWay}" FontSize="{x:Bind Typography.Size, Mode=OneWay}"
                                               FontWeight="{x:Bind Typography.Weight, Mode=OneWay}" FontStyle="{x:Bind Typography.Style, Mode=OneWay}"
                                               controls:EditorColorOverride.Foreground="{x:Bind Palette.Brushes.GetNode(NodeType), Mode=OneWay}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1">
                                        <Run Text="{x:Bind DisplayName, Mode=OneWay}" /><Run Text="{x:Bind IdentifyingText, Mode=OneWay}"
                                             controls:EditorColorOverride.Foreground="{x:Bind Palette.Brushes.IdentifyingText, Mode=OneWay, FallbackValue={x:Null}}" />
                                    </TextBlock>
                                </Grid>
                                <Grid x:Name="ValueCell" Grid.Column="1" MinHeight="{x:Bind Typography.RowHeight, Mode=OneWay}"
                                      Style="{StaticResource NodeValueCellStyle}" Margin="6,0,12,0"
                                      controls:EditorColorOverride.Background="{x:Bind Palette.Brushes.GetContainerBackground(IsContainer), Mode=OneWay}"
                                      DoubleTapped="NodeValue_DoubleTapped">
                                    <TextBlock Text="{x:Bind ValuePreview, Mode=OneWay}" VerticalAlignment="Center" Margin="8,0,8,0"
                                               Style="{StaticResource NodeValuePreviewStyle}"
                                               FontFamily="{x:Bind Typography.Family, Mode=OneWay}" FontSize="{x:Bind Typography.Size, Mode=OneWay}"
                                               FontWeight="{x:Bind Typography.Weight, Mode=OneWay}" FontStyle="{x:Bind Typography.Style, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                               controls:EditorColorOverride.Foreground="{x:Bind Palette.Brushes.GetNode(NodeType), Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </controls:XmlTreeList.ItemTemplate>
                </controls:XmlTreeList>
                <Border Grid.Row="1" Grid.Column="1" Width="1" HorizontalAlignment="Center" IsHitTestVisible="False"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <controls:PaneSplitter Grid.Column="1" IsTabStop="False"
                                       HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Thumb IsTabStop="True" DragDelta="PaneSplitter_DragDelta"
                           DragCompleted="PaneSplitter_DragCompleted" KeyDown="PaneSplitter_KeyDown"
                           ToolTipService.ToolTip="Resize the node and value columns"
                           AutomationProperties.AutomationId="EditorPaneSplitter"
                           AutomationProperties.Name="Resize node and value columns"
                           AutomationProperties.HelpText="Use Left and Right arrows to resize, or Home to reset.">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Border Width="1" HorizontalAlignment="Center"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </controls:PaneSplitter>

                <Grid x:Name="ValueDetails" Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="150,*" ColumnSpacing="12" Padding="16,8"
                      Visibility="Collapsed"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      BorderThickness="0,1,0,0"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Selected value" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="SelectedNodeTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <CheckBox x:Name="WrapValueLines" Content="Wrap lines" IsChecked="True"
                                  Checked="WrapValueLines_Changed" Unchecked="WrapValueLines_Changed" />
                    </StackPanel>
                    <TextBox
                        x:Name="ValueEditor"
                        Grid.Column="1"
                        AcceptsReturn="True"
                        IsReadOnly="{x:Bind ViewModel.IsValueReadOnly, Mode=OneWay}"
                        TextWrapping="Wrap"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        FontFamily="{x:Bind Typography.Family, Mode=OneWay}" FontSize="{x:Bind Typography.Size, Mode=OneWay}"
                        FontWeight="{x:Bind Typography.Weight, Mode=OneWay}" FontStyle="{x:Bind Typography.Style, Mode=OneWay}"
                        controls:EditorColorOverride.Background="{x:Bind ViewModel.Palette.Brushes.EditorBackground, Mode=OneWay, FallbackValue={x:Null}}"
                        VerticalAlignment="Stretch"
                        MinHeight="36"
                        MaxHeight="144"
                        SelectionHighlightColorWhenNotFocused="{ThemeResource TextControlSelectionHighlightColor}"
                        LostFocus="ValueEditor_LostFocus"
                        TextChanged="ValueEditor_TextChanged"
                        PreviewKeyDown="ValueEditor_KeyDown"
                        AutomationProperties.Name="Selected node value"
                        AutomationProperties.AutomationId="NodeValueEditor" />
                </Grid>
            </Grid>
            <StackPanel x:Name="DiagnosticsArea" Grid.Row="1" Visibility="Collapsed">
                <controls:PaneSplitter Orientation="Horizontal" IsTabStop="False"
                                       HorizontalContentAlignment="Stretch">
                    <Thumb x:Name="DiagnosticsSplitter" Height="8" IsTabStop="True"
                           DragDelta="DiagnosticsSplitter_DragDelta" DragCompleted="DiagnosticsSplitter_DragCompleted"
                           KeyDown="DiagnosticsSplitter_KeyDown"
                           ToolTipService.ToolTip="Resize Error List and Dynamic Help"
                           AutomationProperties.AutomationId="DiagnosticsSplitter"
                           AutomationProperties.Name="Resize Error List and Dynamic Help"
                           AutomationProperties.HelpText="Use Up and Down arrows to resize, or Home to reset.">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Border Height="1" VerticalAlignment="Center"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </controls:PaneSplitter>
                <controls:EditorDiagnosticsPane x:Name="DiagnosticsPane" Height="156" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3">
            <InfoBar x:Name="UpdateNotice" IsOpen="False" IsClosable="True"
                     AutomationProperties.AutomationId="UpdateNotice">
                <InfoBar.ActionButton>
                    <Button x:Name="OpenUpdateButton" Content="Get update" Visibility="Collapsed" Click="OpenUpdate_Click"
                            AutomationProperties.AutomationId="GetUpdate" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="FileChangeInfoBar" IsOpen="False" Severity="Warning"
                     AutomationProperties.AutomationId="DocumentFileChange">
                <InfoBar.ActionButton>
                    <Button Content="Reload" Click="ReloadFromDisk_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="ErrorInfoBar" IsClosable="True" IsOpen="False" Severity="Error"
                     AutomationProperties.AutomationId="DocumentError">
                <InfoBar.ActionButton>
                    <Button x:Name="OpenFailedFileButton" Content="Open in text editor" Visibility="Collapsed"
                            Click="OpenFailedFile_Click" AutomationProperties.AutomationId="OpenFailedFileInEditor" />
                </InfoBar.ActionButton>
                <InfoBar.Content>
                    <ListView x:Name="ValidationIssues" MaxHeight="160" Visibility="Collapsed"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="ValidationIssue_Click"
                              AutomationProperties.Name="Validation results">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:XmlValidationIssue">
                                <TextBlock Text="{x:Bind Summary, Mode=OneTime}" TextWrapping="Wrap" Margin="0,6" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </InfoBar.Content>
            </InfoBar>
        </StackPanel>
        <Border x:Name="DocumentStatusBar" Grid.Row="4" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                AutomationProperties.AutomationId="DocumentStatusBar">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" Padding="12,5" MinHeight="28">
                <TextBlock x:Name="StatusXPath" TextTrimming="CharacterEllipsis" FontSize="12"
                           AutomationProperties.AutomationId="StatusXPath" />
                <TextBlock x:Name="StatusPosition" Grid.Column="1" FontSize="12"
                           AutomationProperties.AutomationId="StatusPosition" />
            </Grid>
        </Border>
        <controls:FindReplaceBar
            x:Name="FindReplaceBar"
            Grid.Row="2"
            Canvas.ZIndex="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="12,38,12,0"
            MaxWidth="800"
            Visibility="Collapsed" />

    </Grid>
</Page>
